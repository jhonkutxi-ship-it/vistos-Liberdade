{
  "entities": {
    "User": {
      "title": "User",
      "description": "System user with role-based and granular permission access.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email" },
        "username": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["client", "employee", "admin"] },
        "photoURL": { "type": "string", "format": "uri" },
        "active": { "type": "boolean" },
        "mustChangePassword": { "type": "boolean" },
        "permissions": { "type": "array", "items": { "type": "string" } },
        "staffCode": { "type": "string" },
        "jobTitle": { "type": "string" },
        "departments": { "type": "array", "items": { "type": "string" } },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "idNumber": { "type": "string" },
        "nifNumber": { "type": "string" },
        "birthDate": { "type": "string" },
        "gender": { "type": "string" },
        "nationality": { "type": "string" },
        "maritalStatus": { "type": "string" },
        "academicLevel": { "type": "string" },
        "hireDate": { "type": "string" },
        "salary": { "type": "number" },
        "allowances": { "type": "number" },
        "hourlyRate": { "type": "number" },
        "iban": { "type": "string" },
        "employmentStatus": { "type": "string" },
        "hrNotes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Client": {
      "title": "Client",
      "description": "Detailed client information.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Reference to User entity" },
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "passportNumber": { "type": "string" },
        "nationality": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "dateOfBirth": { "type": "string", "format": "date" }
      },
      "required": ["uid"]
    },
    "Service": {
      "title": "Service",
      "description": "Visa or travel service offered by the agency.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number", "description": "Price in Kz" },
        "description": { "type": "string" },
        "category": { "type": "string", "enum": ["visa", "flight", "transfer", "insurance", "hotel", "package", "training", "other"] },
        "features": { "type": "array", "items": { "type": "string" } },
        "imageUrl": { "type": "string" },
        "subtitle": { "type": "string" },
        "isTrending": { "type": "boolean" },
        "badgeText": { "type": "string" }
      },
      "required": ["id", "name", "price"]
    },
    "Process": {
      "title": "Travel Process",
      "description": "A specific travel or visa application process.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientUid": { "type": "string" },
        "clientName": { "type": "string" },
        "serviceId": { "type": "string" },
        "serviceName": { "type": "string" },
        "assignedEmployeeUid": { "type": "string" },
        "assignedEmployeeName": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "in-review", "approved", "rejected"] },
        "paymentType": { "type": "string", "enum": ["full", "installments"] },
        "paymentStatus": { "type": "string", "enum": ["pending", "partially_paid", "paid"] },
        "price": { "type": "number" },
        "unitPrice": { "type": "number" },
        "memberCount": { "type": "number" },
        "isGroupProcess": { "type": "boolean" },
        "groupName": { "type": "string" },
        "groupMembers": { "type": "array" },
        "paidAmount": { "type": "number" },
        "remainingAmount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "installmentSchedule": { "type": "string", "enum": ["half_50_50", "custom"] },
        "paymentConfirmed": { "type": "boolean" },
        "paymentConfirmedAt": { "type": "string", "format": "date-time" },
        "paymentConfirmedBy": { "type": "string" },
        "paymentHistory": { "type": "array" },
        "progress": { "type": "number", "description": "Percentage 0-100" },
        "notes": { "type": "string" },
        "reviewed": { "type": "boolean" },
        "rating": { "type": "number" },
        "recommended": { "type": "boolean" },
        "dates": { "type": "object" },
        "reminders": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "clientUid", "serviceId", "status", "paymentType"]
    },
    "Document": {
      "title": "Document",
      "description": "Uploaded document metadata for a process.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "processId": { "type": "string" },
        "clientUid": { "type": "string" },
        "name": { "type": "string" },
        "fileName": { "type": "string" },
        "mimeType": { "type": "string" },
        "fileSize": { "type": "number" },
        "hasFileContent": { "type": "boolean" },
        "isAgencyIssued": { "type": "boolean" },
        "url": { "type": "string" },
        "category": { "type": "string" },
        "status": { "type": "string", "enum": ["uploaded", "verified", "rejected"] },
        "uploadedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["processId", "url", "status", "category"]
    },
    "DocumentFile": {
      "title": "Document File Payload",
      "description": "Base64/DataURL payload for uploaded process documents.",
      "type": "object",
      "properties": {
        "docId": { "type": "string" },
        "processId": { "type": "string" },
        "clientUid": { "type": "string" },
        "uploadedBy": { "type": "string" },
        "dataUrl": { "type": "string" },
        "fileName": { "type": "string" },
        "mimeType": { "type": "string" },
        "fileSize": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["docId", "processId", "dataUrl", "fileName", "mimeType"]
    },
    "CompanySettings": {
      "title": "Company & Permissions Settings",
      "description": "Agency branding, NIF, address, logo, and role permission matrix.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "subtitle": { "type": "string" },
        "nif": { "type": "string" },
        "address": { "type": "string" },
        "addressLine2": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "logoUrl": { "type": "string" },
        "receiptFooterNote": { "type": "string" },
        "employee": { "type": "array", "items": { "type": "string" } },
        "client": { "type": "array", "items": { "type": "string" } },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "StaffInvite": {
      "title": "Staff Credential Invite",
      "description": "Salted SHA-256 initial/reset password state for staff accounts.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "username": { "type": "string" },
        "displayName": { "type": "string" },
        "passwordSalt": { "type": "string" },
        "passwordHash": { "type": "string" },
        "role": { "type": "string", "enum": ["employee", "admin"] },
        "active": { "type": "boolean" },
        "mustChangePassword": { "type": "boolean" },
        "permissions": { "type": "array", "items": { "type": "string" } },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "passwordSalt", "passwordHash", "role"]
    },
    "Message": {
      "title": "Message",
      "description": "Internal message between users.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderUid": { "type": "string" },
        "receiverUid": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "read": { "type": "boolean" }
      },
      "required": ["id", "senderUid", "receiverUid", "content", "timestamp"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Airport transfer or travel ticket booking.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientUid": { "type": "string" },
        "clientName": { "type": "string" },
        "tier": { "type": "string" },
        "serviceName": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "time": { "type": "string" },
        "pickupLocation": { "type": "string" },
        "dropoffLocation": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "completed", "cancelled"] },
        "price": { "type": "number" }
      },
      "required": ["id", "clientUid", "tier", "date", "time", "status"]
    },
    "BookingService": {
      "title": "Booking Service Option",
      "description": "Editable transfer or flight ticket service option.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string", "enum": ["transfer", "flight", "vip"] },
        "active": { "type": "boolean" }
      },
      "required": ["id", "name", "price", "category"]
    },
    "EmployeeDocument": {
      "title": "HR Employee Document",
      "description": "Personal HR document attached to an employee profile.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employeeUid": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "fileName": { "type": "string" },
        "mimeType": { "type": "string" },
        "fileSize": { "type": "number" },
        "dataUrl": { "type": "string" },
        "uploadedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "employeeUid", "title", "dataUrl"]
    },
    "EmployeePayslip": {
      "title": "Employee Salary Payslip",
      "description": "Monthly salary receipt issued for an employee.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employeeUid": { "type": "string" },
        "employeeName": { "type": "string" },
        "referenceMonth": { "type": "string" },
        "baseSalary": { "type": "number" },
        "allowances": { "type": "number" },
        "bonus": { "type": "number" },
        "deductions": { "type": "number" },
        "netSalary": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "status": { "type": "string", "enum": ["paid", "pending"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "employeeUid", "referenceMonth", "netSalary"]
    },
    "StaffTask": {
      "title": "Staff Task",
      "description": "Operational task assigned to or created by an operator with deadline alerts.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "in_progress", "waiting", "completed"] },
        "priority": { "type": "string", "enum": ["low", "medium", "high", "urgent"] },
        "isPublic": { "type": "boolean" },
        "billable": { "type": "boolean" },
        "hourlyRate": { "type": "number" },
        "startDate": { "type": "string" },
        "dueDate": { "type": "string" },
        "dueTime": { "type": "string" },
        "repeatEvery": { "type": "string" },
        "relatedType": { "type": "string", "enum": ["", "process", "client", "invoice", "booking"] },
        "relatedEntityId": { "type": "string" },
        "relatedEntityLabel": { "type": "string" },
        "assignedToUid": { "type": "string" },
        "assignedToName": { "type": "string" },
        "assigneeUids": { "type": "array", "items": { "type": "string" } },
        "assigneeNames": { "type": "array", "items": { "type": "string" } },
        "followerUids": { "type": "array", "items": { "type": "string" } },
        "followerNames": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "attachments": { "type": "array" },
        "createdByUid": { "type": "string" },
        "createdByName": { "type": "string" },
        "relatedProcessId": { "type": "string" },
        "checklist": { "type": "array" },
        "completedAt": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "status", "priority", "dueDate", "assignedToUid"]
    },
    "TaskAttachment": {
      "title": "Task Attachment File",
      "description": "Binary payload for a file attached to a staff task.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "taskId": { "type": "string" },
        "fileName": { "type": "string" },
        "mimeType": { "type": "string" },
        "fileSize": { "type": "number" },
        "dataUrl": { "type": "string" },
        "uploadedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "taskId", "fileName", "mimeType", "dataUrl"]
    },
    "FinancialTransaction": {
      "title": "Financial Transaction",
      "description": "Income or expense record.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["income", "expense"] },
        "expenseScope": { "type": "string", "enum": ["daily", "operational", "payroll", "other"] },
        "category": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string", "format": "date" },
        "description": { "type": "string" },
        "relatedTo": { "type": "string" },
        "status": { "type": "string", "enum": ["completed", "pending", "cancelled"] },
        "paymentMethod": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "type", "amount", "date", "description"]
    },
    "EmployeeAdvance": {
      "title": "Employee Advance",
      "description": "Loan or advance to employee.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employeeUid": { "type": "string" },
        "employeeName": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string", "format": "date" },
        "reason": { "type": "string" },
        "type": { "type": "string", "enum": ["loan", "advance"] },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "paid"] },
        "repaymentStatus": { "type": "string", "enum": ["pending", "partially_paid", "fully_repaid"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "employeeUid", "amount", "date", "type", "status"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Billing document or receipt for a process.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "processId": { "type": "string" },
        "clientUid": { "type": "string" },
        "clientName": { "type": "string" },
        "amount": { "type": "number" },
        "dueDate": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["draft", "pending", "sent", "paid", "overdue", "cancelled"] },
        "type": { "type": "string", "enum": ["recibo", "fatura", "fatura_proforma"] },
        "items": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "processId", "clientUid", "amount", "status"]
    },
    "Consultant": {
      "title": "Consultant Profile",
      "description": "Non-PII staff summary selectable by clients for consultancy and advisory.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["employee", "admin"] },
        "specialty": { "type": "string" },
        "photoURL": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["uid", "displayName", "role"]
    },
    "AdvisoryRequest": {
      "title": "Advisory or Consultancy Request",
      "description": "Client scheduled consultancy or visa advisory request linked to an assigned consultant.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientUid": { "type": "string" },
        "clientName": { "type": "string" },
        "clientPhone": { "type": "string" },
        "clientEmail": { "type": "string" },
        "type": { "type": "string", "enum": ["consultoria", "assessoria"] },
        "serviceId": { "type": "string" },
        "serviceName": { "type": "string" },
        "employeeUid": { "type": "string" },
        "employeeName": { "type": "string" },
        "preferredDate": { "type": "string" },
        "preferredTime": { "type": "string" },
        "notes": { "type": "string" },
        "processId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "completed", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "clientUid", "type", "employeeUid", "employeeName", "status"]
    },
    "ServiceReview": {
      "title": "Service Review",
      "description": "Post-completion client rating (1-5 stars), recommendation, and feedback for assigned employee.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "processId": { "type": "string" },
        "clientUid": { "type": "string" },
        "clientName": { "type": "string" },
        "employeeUid": { "type": "string" },
        "employeeName": { "type": "string" },
        "serviceId": { "type": "string" },
        "serviceName": { "type": "string" },
        "rating": { "type": "number" },
        "recommend": { "type": "boolean" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "processId", "clientUid", "employeeUid", "rating", "recommend"]
    },
    "Notification": {
      "title": "Operator Notification",
      "description": "Direct real-time notification sent to a chosen consultant or operator when a client schedules consultancy, requests advisory, or a process is assigned.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "recipientUid": { "type": "string" },
        "recipientName": { "type": "string" },
        "senderUid": { "type": "string" },
        "senderName": { "type": "string" },
        "type": { "type": "string", "enum": ["advisory_request", "consultancy_booking", "process_assigned", "payment_uploaded", "task_assigned", "task_overdue", "system"] },
        "title": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 1000 },
        "requestId": { "type": "string" },
        "processId": { "type": "string" },
        "taskId": { "type": "string" },
        "serviceName": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recipientUid", "type", "title", "message", "read"]
    }
  },
  "firestore": {
    "/users/{uid}": { "schema": "User", "description": "User profiles" },
    "/clients/{uid}": { "schema": "Client", "description": "Extended client data" },
    "/services/{serviceId}": { "schema": "Service", "description": "Available services" },
    "/processes/{processId}": { "schema": "Process", "description": "Travel processes" },
    "/documents/{docId}": { "schema": "Document", "description": "Process documents metadata" },
    "/document_files/{docId}": { "schema": "DocumentFile", "description": "Uploaded document file content" },
    "/settings/{settingId}": { "schema": "CompanySettings", "description": "Agency branding & RBAC config" },
    "/staff_invites/{email}": { "schema": "StaffInvite", "description": "Employee initial login & password reset state" },
    "/messages/{msgId}": { "schema": "Message", "description": "Internal chat messages" },
    "/bookings/{bookingId}": { "schema": "Booking", "description": "Transfer & ticket bookings" },
    "/booking_services/{serviceId}": { "schema": "BookingService", "description": "Editable transfer & ticket services" },
    "/hr_documents/{docId}": { "schema": "EmployeeDocument", "description": "Personal HR documents for staff" },
    "/employee_payslips/{id}": { "schema": "EmployeePayslip", "description": "Employee salary payslips" },
    "/tasks/{taskId}": { "schema": "StaffTask", "description": "Operator tasks & deadline alerts" },
    "/task_attachments/{attId}": { "schema": "TaskAttachment", "description": "Task attachment payloads" },
    "/financial_transactions/{id}": { "schema": "FinancialTransaction", "description": "Income/Expenses" },
    "/employee_advances/{id}": { "schema": "EmployeeAdvance", "description": "Staff loans" },
    "/invoices/{id}": { "schema": "Invoice", "description": "Client invoices and receipts" },
    "/consultants/{uid}": { "schema": "Consultant", "description": "Selectable consultant profiles (non-PII)" },
    "/advisory_requests/{id}": { "schema": "AdvisoryRequest", "description": "Consultancy & advisory requests" },
    "/service_reviews/{id}": { "schema": "ServiceReview", "description": "Completed process star ratings & recommendations" },
    "/notifications/{notifId}": { "schema": "Notification", "description": "Direct notifications for chosen consultants and operators" }
  }
}
